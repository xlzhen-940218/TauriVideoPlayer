{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "西瓜视频播放器",
  "version": "0.1.0",
  "identifier": "com.xiong.taurivideoplayer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "西瓜视频播放器",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "additionalBrowserArgs": "--disable-direct-composition-video-overlays"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
